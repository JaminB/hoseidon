# Node/Docker configuration. On Cloudflare Workers the same names are wrangler vars/secrets:
# see apps/worker/wrangler.jsonc and apps/worker/.dev.vars.example.

# LinkTap cloud credentials (link-tap.com -> API). Leave blank while LINKTAP_MOCK=true.
LINKTAP_USERNAME=
LINKTAP_API_KEY=
# true = talk to the built-in fake LinkTap server. Set false to touch real taps (and real water).
LINKTAP_MOCK=true

# Auth. SESSION_SECRET also encrypts the Google refresh token (16+ chars; `openssl rand -hex 32`).
# On Cloudflare, ADMIN_PASSWORD must be 20+ random chars with real taps (fast PBKDF2 hash there).
SESSION_SECRET=change-me-to-a-long-random-string
# With LINKTAP_MOCK=false the server refuses to start if these are placeholders or too short
# (ADMIN_PASSWORD 12+ chars, WEBHOOK_SECRET and SESSION_SECRET 16+).
ADMIN_PASSWORD=change-me

# Google Calendar sync (optional, see README). Redirect URI: ${PUBLIC_URL}/api/gcal/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google sign-in (optional): set with the two above and Hoseidon uses "Sign in with Google"
# instead of ADMIN_PASSWORD. These accounts (comma-separated) are always admins and can invite
# others. Second redirect URI: ${PUBLIC_URL}/api/auth/google/callback
ADMIN_EMAIL=

# Behind a Cloudflare Tunnel or reverse proxy, set true so login throttling sees real client IPs
TRUST_PROXY=false

# Public HTTPS URL (Cloudflare Tunnel) used for webhooks and OAuth redirects
PUBLIC_URL=http://localhost:8787
WEBHOOK_SECRET=change-me-too

# Server
PORT=8787
DATABASE_PATH=./data/hoseidon.sqlite
TZ=America/New_York

# Only needed for `docker compose --profile tunnel up`
CLOUDFLARE_TUNNEL_TOKEN=

# Cloudflare Workers only (ignored by Node): ENGINE_ENABLED=true lets the poller and scheduler
# drive real taps (it is off with LINKTAP_MOCK=false until you set it). Never run Node and
# Workers against one LinkTap account at the same time.
# ENGINE_ENABLED=
