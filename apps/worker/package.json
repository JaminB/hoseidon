{
  "name": "@hoseidon/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hoseidon on Cloudflare Workers (Free plan): static PWA + one SQLite Durable Object.",
  "scripts": {
    "gen": "node scripts/gen-migrations.mjs",
    "dev": "node scripts/gen-migrations.mjs && wrangler dev --port 8799",
    "build": "node scripts/gen-migrations.mjs --check && wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "types": "wrangler types --env-interface Env src/worker-configuration.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hoseidon/server": "workspace:*",
    "@hoseidon/shared": "workspace:*",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@hoseidon/web": "workspace:*",
    "@types/node": "^26.6.6",
    "typescript": "~6",
    "vitest": "^5.1.1",
    "wrangler": "4.160.1"
  }
}
