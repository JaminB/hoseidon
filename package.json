{
  "name": "hoseidon",
  "version": "0.1.0",
  "private": true,
  "description": "Hoseidon, god of the garden hose. A self-hosted PWA for LinkTap smart water timers.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"pnpm --filter @hoseidon/server dev\" \"pnpm --filter @hoseidon/web dev\"",
    "build": "pnpm -r build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
